# Canonical LF line endings across all platforms
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files
*.pdf binary
*.png binary
*.gz binary
*.zip binary

# Preserve exact experimental evidence bytes, including source-hash snapshots.
results/exploratory/K_RESPONSE_001/** -text
